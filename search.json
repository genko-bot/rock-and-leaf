---
layout: null
---
[
  {% for post in site.posts %}
  {
    "title": "{{ post.title | escape }}",
    "content": "{{ post.content | strip_html | truncate: 200 | escape }}",
    "tags": "{{ post.tags | join: ", " | escape }}",
    "url": "{{ post.url | relative_url }}"
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
